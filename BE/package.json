{
  "name": "eng",
  "version": "0.0.1",
  "description": "Mezon bot built with Nezon",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d ./src/typeorm-cli.ts",
    "test:interview": "ts-node src/test/test-interview-agent.ts",
    "test:interview:auto": "ts-node src/test/test-interview-agent.ts auto",
    "test:scenarios": "ts-node src/test/test-scenarios.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/database-test/migrations/UpdateTestDB",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:create": "typeorm-ts-node-commonjs migration:create src/database-test/migrations/NewMigration"
  },
  "dependencies": {
    "@bull-board/api": "^6.14.2",
    "@bull-board/express": "^6.14.2",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.1.0",
    "@langchain/google-genai": "^2.1.0",
    "@langchain/langgraph": "^1.0.2",
    "@langchain/openai": "^1.1.3",
    "@n0xgg04/nezon": "1.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.13.2",
    "bull": "^4.16.5",
    "dotenv": "^17.2.3",
    "event-source-polyfill": "^1.0.31",
    "eventsource": "^4.0.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "joi": "^18.0.1",
    "langchain": "^1.0.6",
    "langsmith": "^0.3.81",
    "mezon-sdk": "2.8.50",
    "minio": "^8.0.6",
    "pg": "^8.16.3",
    "readline": "^1.3.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.25",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.5.0",
    "nodemon": "^3.1.11",
    "prettier": "^2.8.8",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
